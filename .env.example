# Advisor Brief — environment template. Copy to .env.local (gitignored) and fill values.
# Server-side only. Never prefix any of these with NEXT_PUBLIC_ (Portkey key must stay server-side).

# Portkey AI gateway (values from the challenge brief; key issued at interview start)
PORTKEY_BASE_URL=https://portkeygateway.perficient.com/v1
PORTKEY_MODEL=@aws-bedrock-use2/us.anthropic.claude-sonnet-4-5-20250929-v1:0
PORTKEY_API_KEY=

# Required by SEC fair-access policy on every sec.gov request: "<App> <contact-email>"
SEC_USER_AGENT=AdvisorBriefPrototype contact@example.com
